# ==============================================================
# UNIVERSAL RAG ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================
# Copy this file to .env and provide your credentials as needed:
# cp .env.example .env

# LLM & Embedding Settings
# Note: If OPENAI_API_KEY is left blank, the system automatically runs
# in offline mode using deterministic 1536-dimensional local embeddings
# and grounded extractive responses without external API costs.
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
EMBEDDING_MODEL=text-embedding-3-small

# Ingestion & Chunking Parameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=25

# Retrieval & LangGraph Settings
TOP_K=4
SIMILARITY_THRESHOLD=0.0
MAX_RETRIES=1

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
